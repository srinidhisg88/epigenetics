# Epilepsy Diagnostic Assistant Environment Configuration
# Copy this file to .env and fill in your values

# Groq API Key (required for RAG/Chat functionality)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model paths (optional - defaults are used if not specified)
MODEL_PATH=models/epilepsy_classifier_no_phenotype.pkl
FAISS_INDEX_PATH=data/faiss_index/index.faiss
CHUNKS_MAP_PATH=data/faiss_index/chunks.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
